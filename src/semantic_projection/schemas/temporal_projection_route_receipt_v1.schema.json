{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temporal_projection_route_receipt_v1.schema.json",
  "title": "Temporal Projection Route Receipt v1",
  "type": "object",
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "package_type", "contract_version", "source_bundle_id",
        "source_temporal_graph_id", "request_id", "projected_graph_id",
        "profile_id", "profile_version", "target_family", "output_mode",
        "summary_semantic_hashes", "route_hash"
      ],
      "properties": {
        "package_type": {"const": "temporal_projection_route_receipt"},
        "contract_version": {"const": "1.0.0"},
        "source_bundle_id": {"type": ["string", "null"]},
        "source_temporal_graph_id": {"type": ["string", "null"]},
        "request_id": {"type": "string"},
        "projected_graph_id": {"type": ["string", "null"]},
        "profile_id": {"type": "string"},
        "profile_version": {"type": "string"},
        "context_id": {"type": ["string", "null"]},
        "context_version": {"type": ["string", "null"]},
        "target_family": {"type": "string"},
        "output_mode": {"enum": ["full", "standard", "summary", "forensic"]},
        "summary_semantic_hashes": {"type": "object"},
        "coverage": {"type": "object"},
        "route_hash": {"type": "string", "minLength": 24, "maxLength": 24}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
