{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Projection Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "profile_id",
    "profile_version",
    "source_graph",
    "structural_evidence",
    "source_identity",
    "context",
    "source_registries",
    "options"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "profile_version": {
      "type": "string"
    },
    "source_graph": {
      "type": "object",
      "required": [
        "graph_type",
        "graph_version",
        "objects",
        "relationships"
      ]
    },
    "structural_evidence": {
      "type": "object"
    },
    "source_identity": {
      "type": "object",
      "required": [
        "source_chart_ids",
        "sensor_instance_id"
      ]
    },
    "context": {
      "type": "object"
    },
    "source_registries": {
      "type": "object"
    },
    "options": {
      "$ref": "projection_options_v1.schema.json"
    }
  }
}
