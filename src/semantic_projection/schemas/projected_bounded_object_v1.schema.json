{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Projected Bounded Object v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "correspondence_id", "object_type", "name", "target_ontology",
    "operators", "attributes", "source_refs", "mapping_rule_refs",
    "context_refs", "epistemic_basis", "provenance"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "correspondence_id": {"type": "string", "pattern": "^bounded_correspondence:object:"},
    "object_type": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "target_ontology": {"type": "string", "minLength": 1},
    "operators": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "attributes": {"type": "object"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "mapping_rule_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "context_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "epistemic_basis": {"$ref": "#/$defs/epistemic_basis"},
    "projection_relevance_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "provenance": {"type": "object"},
    "structural_strength_score": false
  },
  "$defs": {
    "epistemic_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "evidence_refs", "evidence_family_groups", "proof_scope"],
      "properties": {
        "classification": {"const": "invariant"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "evidence_family_groups": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "proof_scope": {"type": "string", "minLength": 1}
      }
    }
  }
}
